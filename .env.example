# Public deployment
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_COMMUNITY_FORMS_ENABLED=false
# Set only after policies, public profiles, contacts, and operating procedures are approved.
COMMUNITY_LAUNCH_APPROVED=false

# Supabase (use the publishable key when available)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Administrator access; comma-separated and enforced before magic-link delivery
ADMIN_EMAILS=

# Transactional email
RESEND_API_KEY=
RESEND_FROM_EMAIL="Beneficence Community <community@mail.example.org>"
MONITORED_CONTACT_EMAIL=

# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Public operational destinations
SCHEDULING_URL=
GITHUB_REPOSITORY_URL=https://github.com/tempest2023/BeneficenceProtocol

# Server-only protections; use independent high-entropy values
IP_HASH_SECRET=
CRON_SECRET=
